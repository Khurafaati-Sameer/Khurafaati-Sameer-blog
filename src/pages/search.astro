---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categorySlug, tagSlug } from '../data/taxonomy.js';

const articles = (await getCollection('articles'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map(({ id, data }) => ({
    slug: id,
    title: data.title,
    description: data.description,
    category: data.category,
    tags: data.tags,
    date: data.pubDate.toISOString(),
    readingTime: data.readingTime || null,
  }));
---
<Layout title="Search Articles | Khurafaati Sameer" description="Search all published Khurafaati Sameer articles by title, topic, category or tag.">
  <main class="wrap">
    <header class="heading"><p>KHURAFAATI SAMEER</p><h1>Search Articles</h1><span>Search across every published article, category and tag.</span></header>
    <form id="searchForm" class="search-form"><label for="query">Search</label><div><input id="query" name="q" type="search" placeholder="Try: Instagram, relationships, money..." autocomplete="off" /><button type="submit">Search 🔎</button></div></form>
    <div class="search-meta" id="searchMeta" aria-live="polite"></div>
    <div id="results" class="grid"></div>
    <div id="empty" class="empty" hidden><strong>No matching articles.</strong><p>Try a different keyword, category or tag.</p></div>
  </main>
  <script define:vars={{ articles, categorySlug, tagSlug }}>
    const form=document.getElementById('searchForm');
    const input=document.getElementById('query');
    const results=document.getElementById('results');
    const meta=document.getElementById('searchMeta');
    const empty=document.getElementById('empty');
    const normalize=value=>String(value||'').toLowerCase().trim();
    const escapeHtml=value=>String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    function render(query=''){
      const q=normalize(query);
      const terms=q.split(/\s+/).filter(Boolean);
      const matches=articles.filter(a=>{
        const haystack=normalize([a.title,a.description,a.category,...a.tags].join(' '));
        return terms.every(term=>haystack.includes(term));
      });
      meta.textContent=q?`${matches.length} result${matches.length===1?'':'s'} for “${query}”`:`${articles.length} published articles available`;
      empty.hidden=matches.length!==0;
      results.innerHTML=matches.map(a=>`<article class="card"><div class="body"><a class="category" href="/category/${categorySlug(a.category)}/">${escapeHtml(a.category)}</a><h2><a href="/articles/${encodeURIComponent(a.slug)}/">${escapeHtml(a.title)}</a></h2><p>${escapeHtml(a.description)}</p><div class="tags">${a.tags.map(t=>`<a href="/tag/${tagSlug(t)}/">#${escapeHtml(t)}</a>`).join('')}</div><div class="date">${new Date(a.date).toLocaleDateString('en-IN',{dateStyle:'medium'})}${a.readingTime?` • ${a.readingTime} min read`:''}</div></div></article>`).join('');
    }
    const initial=new URLSearchParams(location.search).get('q')||'';
    input.value=initial;
    render(initial);
    form.addEventListener('submit',event=>{event.preventDefault();const q=input.value.trim();const url=q?`/search/?q=${encodeURIComponent(q)}`:'/search/';history.pushState({},'',url);render(q);});
  </script>
  <style>
    .wrap{max-width:1180px;margin:auto;padding:60px 20px 90px}.heading{margin-bottom:28px}.heading p{font-size:11px;font-weight:900;color:var(--accent);letter-spacing:.8px}.heading h1{color:var(--text);font-size:clamp(38px,5vw,58px);letter-spacing:-2px;margin:4px 0 8px}.heading span{color:var(--muted);font-size:14px}.search-form{max-width:820px;margin-bottom:22px}.search-form label{display:block;font-size:12px;font-weight:900;margin-bottom:7px}.search-form div{display:flex;gap:8px}.search-form input{flex:1;min-width:0;border:1px solid var(--border);border-radius:10px;padding:13px 15px;font-size:15px;outline:none}.search-form input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(255,61,0,.1)}.search-form button{border:0;border-radius:10px;background:var(--accent);color:#fff;padding:0 20px;font-weight:900;cursor:pointer}.search-meta{color:var(--muted);font-size:12px;margin:18px 0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{border:1px solid var(--border);border-radius:14px;background:#fff;overflow:hidden}.body{padding:20px}.category{font-size:11px;color:var(--accent);font-weight:900}.card h2{font-size:19px;line-height:1.3;margin:8px 0}.card h2 a:hover{color:var(--accent)}.card p{color:var(--muted);font-size:13px;line-height:1.6}.tags{display:flex;flex-wrap:wrap;gap:6px;margin:13px 0}.tags a{background:var(--accent-light);color:var(--accent);border-radius:20px;padding:4px 8px;font-size:10px;font-weight:800}.date{color:var(--muted);font-size:11px}.empty{border:1px dashed var(--border);border-radius:14px;text-align:center;padding:45px 20px;color:var(--muted)}.empty strong{display:block;color:var(--text);font-size:18px;margin-bottom:5px}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.wrap{padding:42px 16px 70px}.grid{grid-template-columns:1fr}.search-form div{flex-direction:column}.search-form button{padding:12px}}
  </style>
</Layout>
