---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths(){const articles=await getCollection('articles');return articles.filter(({data})=>!data.draft).map(article=>({params:{slug:article.id},props:{article}}));}
const {article}=Astro.props;const {Content}=await render(article);const {data}=article;const canonical=new URL(`/articles/${article.id}/`,Astro.site).toString();const pageTitle=data.seoTitle||`${data.title} | Khurafaati Sameer`;const pageDescription=data.seoDescription||data.description;
---
<Layout title={pageTitle} description={pageDescription} canonical={canonical} image={data.featuredImage || '/og-default.svg'} type="article" publishedTime={data.pubDate} modifiedTime={data.updatedDate} author={data.author}><article class="article"><header class="article-head"><div class="category">{data.category}</div><h1>{data.title}</h1><p class="description">{data.description}</p><div class="meta">By {data.author} • {data.pubDate.toLocaleDateString('en-IN',{dateStyle:'long'})}{data.updatedDate ? ` • Updated ${data.updatedDate.toLocaleDateString('en-IN',{dateStyle:'medium'})}` : ''}{data.readingTime ? ` • ${data.readingTime} min read` : ''}</div><div class="tags">{data.tags.map(tag=><a href={`/tag/${tag.toLowerCase().trim().replace(/[^a-z0-9]+/g,'-')}/`}>#{tag}</a>)}</div></header>{data.featuredImage&&<img class="hero-image" src={data.featuredImage} alt={data.imageAlt||data.title}/>}<div class="content"><Content/></div><footer class="article-footer"><a href="/articles/">← Back to all articles</a><a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener noreferrer">Share ↗</a></footer></article><style>.article{max-width:820px;margin:auto;padding:65px 20px 90px}.article-head{text-align:center}.category{color:var(--accent);font-size:12px;font-weight:900;margin-bottom:12px}.article h1{max-width:800px;margin:0 auto 16px;font-size:clamp(36px,5vw,58px);line-height:1.03;letter-spacing:-2px}.description{max-width:680px;margin:0 auto 15px;color:var(--muted);font-size:17px;line-height:1.65}.meta{color:var(--muted);font-size:12px}.tags{display:flex;justify-content:center;flex-wrap:wrap;gap:7px;margin-top:18px}.tags a{background:var(--accent-light);color:var(--accent);border-radius:20px;padding:5px 10px;font-size:11px;font-weight:800}.hero-image{width:100%;max-height:480px;object-fit:cover;border-radius:16px;margin:38px 0}.content{font-size:17px;line-height:1.85}.content :global(h2){font-size:27px;margin:35px 0 12px}.content :global(h3){font-size:21px;margin:28px 0 10px}.content :global(p){margin:0 0 20px}.content :global(ul),.content :global(ol){margin:0 0 22px;padding-left:25px}.content :global(a){color:var(--accent);text-decoration:underline}.article-footer{border-top:1px solid var(--border);margin-top:45px;padding-top:20px;display:flex;justify-content:space-between;font-size:13px;font-weight:800}.article-footer a:hover{color:var(--accent)}</style></article>
