---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).filter(({ data }) => !data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="All Articles | Khurafaati Sameer" description="Read the latest articles from Khurafaati Sameer.">
  <main class="wrap">
    <header class="heading"><div><p>KHURAFAATI SAMEER</p><h1>All Articles</h1><span>{articles.length} published articles</span></div><a class="search" href="/search/">🔎 Search articles</a></header>
    <div class="grid">{articles.map(({ id, data }) => <article class="card">{data.featuredImage && <img src={data.featuredImage} alt={data.imageAlt || data.title} loading="lazy" />}<div class="body"><div class="category">{data.category}</div><h2><a href={`/articles/${id}/`}>{data.title}</a></h2><p>{data.description}</p><div class="meta">{data.author} • {data.pubDate.toLocaleDateString('en-IN', { dateStyle: 'medium' })}{data.readingTime ? ` • ${data.readingTime} min read` : ''}</div><a class="read" href={`/articles/${id}/`}>Read article →</a></div></article>)}</div>
  </main>
  <style>
    .wrap{max-width:1180px;margin:auto;padding:60px 20px 90px}.heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:30px}.heading p{font-size:11px;font-weight:900;color:var(--accent);letter-spacing:.8px}.heading h1{color:var(--text);font-size:clamp(38px,5vw,58px);letter-spacing:-2px;margin:4px 0 6px}.heading span{color:var(--muted);font-size:13px}.search{background:var(--accent);color:#fff;padding:10px 14px;border-radius:9px;font-size:12px;font-weight:900}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{border:1px solid var(--border);border-radius:14px;overflow:hidden;background:#fff}.card img{width:100%;height:190px;object-fit:cover}.body{padding:18px}.category{font-size:11px;font-weight:900;color:var(--accent);margin-bottom:7px}.card h2{font-size:18px;line-height:1.3;margin-bottom:9px}.card h2 a:hover{color:var(--accent)}.card p{color:var(--muted);font-size:13px;margin-bottom:12px}.meta{color:var(--muted);font-size:11px}.read{display:inline-block;margin-top:14px;font-size:12px;font-weight:900;color:var(--accent)}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.wrap{padding:42px 16px 70px}.heading{align-items:flex-start;flex-direction:column}.grid{grid-template-columns:1fr}.card img{height:210px}}
  </style>
</Layout>
