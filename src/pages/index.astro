---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categorySlug, tagSlug } from '../data/taxonomy.js';
const articles=(await getCollection('articles')).filter(({data})=>!data.draft).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const latest=articles.slice(0,6); const categories=[...new Set(articles.map(({data})=>data.category))]; const tags=[...new Set(articles.flatMap(({data})=>data.tags))];
---
<Layout title="Khurafaati Sameer – Viral Entertainment & Lifestyle Blog">
<div class="topbar">🔥 KHURAFAATI SAMEER — Trending, relatable & useful stories from India</div>
<header><nav class="nav"><a href="/" class="logo">Khurafaati <span>Sameer</span></a><div class="links" id="navLinks"><a href="/">Home</a><a href="/articles/">Articles</a><a href="#categories">Categories</a><a href="#trending">Trending</a><a href="#about">About</a><a href="/contact/">Contact</a></div><div class="nav-actions"><a class="search-link" href="/search/">🔍 Search</a><button class="mobile-menu" id="menuButton" aria-label="Open menu" aria-expanded="false">☰</button></div></nav></header>
<main>
<section class="hero"><div class="hero-inner"><span class="eyebrow">🔥 India's Viral & Relatable Blog</span><h1>Trending.<br/>Viral.<br/>Relatable.</h1><p>Entertainment, relationships, money, technology and internet culture — curated by Khurafaati Sameer.</p><div class="buttons"><a href="/articles/" class="btn primary">Read Latest Articles</a><a href="#about" class="btn secondary">About Me</a></div></div></section>
<section class="newsletter"><div><p class="category">📩 STAY UPDATED</p><h2>Get the latest from Khurafaati Sameer</h2><p class="muted">No spam. Just new articles and useful updates.</p></div><form name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/"><input type="hidden" name="form-name" value="newsletter"/><input type="hidden" name="subject" value="New Khurafaati Sameer newsletter subscriber"/><p class="hidden"><label>Don't fill this out: <input name="bot-field"/></label></p><div class="newsletter-row"><label class="sr-only" for="newsletter-email">Email address</label><input id="newsletter-email" name="email" type="email" placeholder="Enter your email..." autocomplete="email" required/><button type="submit" class="btn primary">Subscribe Free 🚀</button></div><label class="consent"><input type="checkbox" name="consent" value="yes" required/> I agree to receive email updates from Khurafaati Sameer.</label></form></section>
<section id="trending"><div class="section-title"><div><p>WHAT'S HOT</p><h2>Latest Stories</h2></div><a class="btn small" href="/articles/">View all →</a></div><div class="cards">{latest.map(({id,data},index)=><article class="card"><div class="card-top">{['🔥','💑','💰','🎬','📱','😂'][index%6]}</div><div class="card-body"><a class="category" href={`/category/${categorySlug(data.category)}/`}>{data.category}</a><h3><a href={`/articles/${id}/`}>{data.title}</a></h3><p>{data.description}</p><p class="meta">{data.author} • {data.pubDate.toLocaleDateString('en-IN',{dateStyle:'medium'})}{data.readingTime?` • ${data.readingTime} min read`:''}</p></div></article>)}</div></section>
<section id="categories"><div class="section-title"><div><p>EXPLORE</p><h2>Browse Categories</h2></div></div><div class="categories">{categories.map(category=><a href={`/category/${categorySlug(category)}/`} class="category-box"><div class="icon">{category==='Relationships'?'💑':category==='Money & Career'?'💰':category==='Entertainment'?'🎬':category==='Tech & Social Media'?'📱':category==='Funny & Relatable'?'😂':'🔥'}</div><h3>{category}</h3><p>{articles.filter(({data})=>data.category===category).length} articles</p></a>)}</div></section>
<section><div class="section-title"><div><p>DISCOVER</p><h2>Popular Tags</h2></div></div><div class="tags">{tags.map(tag=><a class="tag" href={`/tag/${tagSlug(tag)}/`}>#{tag}</a>)}</div></section>
<section class="stats"><div class="stat"><strong>{articles.length}</strong><span>Published Articles</span></div><div class="stat"><strong>{categories.length}</strong><span>Categories</span></div><div class="stat"><strong>{tags.length}</strong><span>Topics & Tags</span></div><div class="stat"><strong>2026</strong><span>Publishing Year</span></div></section>
<section id="about"><div class="about-box"><div><p class="category">😎 KHURAFAATI SAMEER</p><h2>Building a relatable digital space for Indian readers.</h2><p>Khurafaati Sameer brings together stories, ideas and practical insights across relationships, entertainment, money, technology and internet culture.</p></div><div class="about-emoji">😎</div></div></section>
</main>
<footer><div class="footer-grid"><div><h2>Khurafaati Sameer</h2><p>Trending, relatable and useful content from India.</p></div><div><h3>Explore</h3><ul><li><a href="/articles/">All Articles</a></li><li><a href="#categories">Categories</a></li><li><a href="/search/">Search</a></li></ul></div><div><h3>Popular</h3><ul>{tags.slice(0,4).map(tag=><li><a href={`/tag/${tagSlug(tag)}/`}>#{tag}</a></li>)}</ul></div><div><h3>Legal</h3><ul><li><a href="/privacy/">Privacy Policy</a></li><li><a href="/terms/">Terms</a></li><li><a href="/disclaimer/">Disclaimer</a></li></ul></div></div><div class="copyright">© 2026 Khurafaati Sameer — All Rights Reserved.</div></footer>
<style>
.topbar{background:#111;color:#fff;text-align:center;padding:8px 15px;font-size:12px;font-weight:700}header{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.98);backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}.nav{max-width:1180px;margin:auto;min-height:58px;display:flex;align-items:center;gap:20px;padding:8px 20px}.logo{font-size:20px;font-weight:900;white-space:nowrap}.logo span{color:var(--accent)}.links{display:flex;gap:18px;margin-left:auto;font-size:13px;font-weight:700}.links a:hover{color:var(--accent)}.nav-actions{display:flex;align-items:center;gap:10px;margin-left:auto}.search-link{font-size:13px;font-weight:800}.mobile-menu{display:none;background:none;border:0;font-size:24px;cursor:pointer}.hero{background:radial-gradient(circle at 80% 20%,rgba(255,61,0,.22),transparent 35%),linear-gradient(135deg,#111 0%,#21120d 100%);color:white;padding:84px 20px 76px}.hero-inner{max-width:1180px;margin:auto}.eyebrow{display:inline-block;background:var(--accent);padding:7px 13px;border-radius:30px;font-weight:800;font-size:12px;margin-bottom:16px}h1{max-width:700px;font-size:clamp(42px,6vw,68px);line-height:.95;letter-spacing:-2.5px;margin-bottom:18px}.hero p{max-width:620px;color:#d1d1d1;font-size:17px;margin-bottom:26px}.buttons{display:flex;gap:12px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;border-radius:10px;font-weight:800;border:1px solid #ddd}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.btn.secondary{background:transparent;color:#fff;border-color:#fff}.btn.small{padding:8px 14px;font-size:12px;color:var(--text)}section{max-width:1180px;margin:auto;padding:56px 20px}.section-title{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:20px}.section-title p{color:var(--muted);font-size:11px;font-weight:800;letter-spacing:.6px}.section-title h2{font-size:26px}.newsletter{display:grid;grid-template-columns:.8fr 1.2fr;gap:28px;align-items:center;max-width:1000px;margin:-34px auto 0;position:relative;background:#fff;border:1px solid var(--border);box-shadow:0 14px 40px rgba(0,0,0,.1);border-radius:16px;padding:25px}.newsletter h2{font-size:22px}.muted{color:var(--muted);font-size:13px}.newsletter-row{display:flex;gap:8px}.newsletter-row input{flex:1;min-width:0;border:1px solid #ddd;border-radius:10px;padding:11px 13px}.consent{display:block;color:var(--muted);font-size:11px;margin-top:9px}.consent input{margin-right:6px}.hidden{position:absolute;left:-10000px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{border:1px solid var(--border);border-radius:14px;overflow:hidden;background:white;transition:.2s}.card:hover{transform:translateY(-3px);box-shadow:0 12px 25px rgba(0,0,0,.07)}.card-top{height:150px;background:linear-gradient(135deg,#151515,#35170d);display:grid;place-items:center;font-size:44px}.card-body{padding:16px}.category{color:var(--accent);font-size:11px;font-weight:900;margin-bottom:6px}.card h3{font-size:16px;line-height:1.35;margin-bottom:8px}.card h3 a:hover{color:var(--accent)}.card-body>p:not(.meta){color:var(--muted);font-size:12px;margin-bottom:10px}.meta{color:var(--muted);font-size:11px}.categories{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.category-box{border:1px solid var(--border);border-radius:12px;padding:20px}.category-box:hover{border-color:var(--accent)}.category-box .icon{font-size:28px}.category-box h3{margin:8px 0 2px;font-size:14px}.category-box p{color:var(--muted);font-size:12px}.tags{display:flex;flex-wrap:wrap;gap:8px}.tag{display:inline-block;padding:7px 11px;border-radius:30px;background:var(--accent-light);color:var(--accent);font-size:12px;font-weight:800}.stats{background:var(--accent);color:white;max-width:none;display:grid;grid-template-columns:repeat(4,1fr);text-align:center;padding:38px 20px}.stat strong{display:block;font-size:32px}.stat span{font-size:12px}.about-box{background:#111;color:white;border-radius:18px;padding:36px;display:grid;grid-template-columns:1fr .8fr;gap:36px}.about-box p{color:#ccc;margin:12px 0;font-size:14px}.about-emoji{display:grid;place-items:center;font-size:110px}footer{background:#111;color:white;padding:50px 20px 20px}.footer-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px}footer p,footer li{color:#aaa;font-size:13px}footer ul{list-style:none;display:grid;gap:6px}footer a:hover{color:white}.copyright{max-width:1180px;margin:40px auto 0;padding-top:16px;border-top:1px solid #292929;text-align:center;color:#888;font-size:12px}@media(max-width:900px){.links{display:none;position:absolute;top:58px;left:0;right:0;background:white;padding:20px;flex-direction:column;border-bottom:1px solid var(--border)}.links.open{display:flex}.mobile-menu{display:block}.search-link{display:none}.newsletter{grid-template-columns:1fr}.cards,.categories{grid-template-columns:repeat(2,1fr)}.about-box{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr);gap:24px}.footer-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){section{padding:42px 16px}.newsletter{margin:0 16px;padding:20px}.newsletter-row{flex-direction:column}.cards,.categories{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.footer-grid{grid-template-columns:1fr}.about-emoji{font-size:70px}}
</style>
<script>const menuBtn=document.getElementById('menuButton');const navLinks=document.getElementById('navLinks');menuBtn?.addEventListener('click',()=>{const open=!navLinks.classList.contains('open');navLinks.classList.toggle('open',open);menuBtn.setAttribute('aria-expanded',String(open));menuBtn.textContent=open?'✕':'☰'});navLinks?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>navLinks.classList.remove('open')));</script>
</Layout>