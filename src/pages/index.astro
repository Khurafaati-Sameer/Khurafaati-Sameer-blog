---
import Layout from '../layouts/Layout.astro';
import { articles, topics, categories, videos, roadmap } from '../data/articles.js';
---

<Layout title="Khurafaati Sameer – Viral Entertainment & Lifestyle Blog">
  <div class="topbar">🔥 KHURAFAATI SAMEER – India's Most Viral Entertainment Hub | New Articles Daily!</div>

  <header>
    <nav class="nav">
      <a href="#home" class="logo">Khurafaati <span>Sameer</span></a>
      <div class="links" id="navLinks">
        <a href="#home">Home</a>
        <a href="#categories">Categories</a>
        <a href="#trending">Trending</a>
        <a href="#videos">Videos</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </div>
      <div class="nav-actions">
        <label class="sr-only" for="searchBox">Search articles</label>
        <input id="searchBox" class="search" type="search" placeholder="🔍 Search..." autocomplete="off" />
        <button class="mobile-menu" id="menuButton" aria-label="Open menu" aria-expanded="false">☰</button>
      </div>
    </nav>
  </header>

  <main id="home">
    <section class="hero">
      <div class="hero-inner">
        <span class="eyebrow">🔥 India's #1 Viral Blog</span>
        <h1>Trending.<br/>Viral.<br/>Relatable.</h1>
        <p>Entertainment, relationships, money tips & viral content curated for Indian youth by Khurafaati Sameer.</p>
        <div class="buttons">
          <a href="#articles" class="btn primary">Read Latest Articles</a>
          <a href="#about" class="btn secondary">About Me</a>
        </div>
      </div>
    </section>

    <div class="newsletter" id="newsletter">
      <h2>🎁 Get FREE Daily Updates</h2>
      <p>Join 10,000+ subscribers. No spam — only viral, relatable content.</p>
      <form class="newsletter-form" id="newsletterForm" novalidate>
        <input type="email" id="emailInput" placeholder="Enter your email..." required aria-label="Email address" />
        <button type="submit">Subscribe Free 🚀</button>
      </form>
      <div id="toast" class="toast" role="status" aria-live="polite"></div>
    </div>

    <section id="trending">
      <div class="section-title"><div><p>WHAT'S HOT</p><h2>Trending Now</h2></div></div>
      <div class="trend-strip">
        <span class="trend">🔥 Top 10 Viral Trends This Week</span>
        <span class="trend">💑 20 Signs Someone Secretly Likes You</span>
        <span class="trend">💰 15 Side Hustles with Zero Investment</span>
        <span class="trend">📱 Instagram Algorithm Explained</span>
        <span class="trend">🎬 Best Web Series to Binge</span>
      </div>
    </section>

    <section id="articles">
      <div class="section-title"><div><p>FRESH FROM SAMEER</p><h2>Latest Articles</h2></div><span id="resultCount" class="result-count"></span></div>
      <div class="cards" id="articleGrid">
        {articles.map(a => (
          <article class="card article-card" data-title={(a.title + ' ' + a.category).toLowerCase()} data-id={a.id}>
            <div class="card-top">{a.icon}</div>
            <div class="card-body">
              {a.isNew && <span class="badge-new">NEW</span>}
              <div class="category">{a.category}</div>
              <h3>{a.title}</h3>
              <p class="meta">{a.meta}</p>
              <p class="meta">{a.views}</p>
            </div>
          </article>
        ))}
      </div>
      <div id="noResults" class="no-results" hidden>
        <p>😕 No articles found for "<span id="noResultsTerm"></span>"</p>
        <button id="clearSearch" class="btn small">Clear search</button>
      </div>
    </section>

    <section>
      <div class="section-title"><div><p>WHAT PEOPLE ARE READING</p><h2>Trending Topics</h2></div></div>
      <div class="topic-grid">
        {topics.map(t => (
          <article class="topic"><div class="topic-icon">{t.icon}</div><div><div class="category">{t.cat}</div><h3>{t.title}</h3><small>👁 {t.views} • 📅 {t.date}</small></div></article>
        ))}
      </div>
    </section>

    <section id="categories">
      <div class="section-title"><div><p>EXPLORE</p><h2>Browse Categories</h2></div></div>
      <div class="categories">
        {categories.map(c => (<a href="#articles" class="category-box"><div class="icon">{c.icon}</div><h3>{c.name}</h3><p>{c.count}</p></a>))}
      </div>
    </section>

    <section class="stats">
      <div class="stat"><strong>1L+</strong><span>Monthly Visitors</span></div>
      <div class="stat"><strong>500+</strong><span>Articles Published</span></div>
      <div class="stat"><strong>50K+</strong><span>Social Followers</span></div>
      <div class="stat"><strong>10K+</strong><span>Email Subscribers</span></div>
    </section>

    <section id="videos">
      <div class="section-title"><div><p>WATCH NOW</p><h2>Latest Videos</h2></div><a class="btn primary small" href="https://youtube.com/@khurafaati_sameer" target="_blank" rel="noopener">Visit YouTube</a></div>
      <div class="video-grid">
        {videos.map(v => (<article class="video"><div class="video-thumb">{v.icon}<span>▶</span></div><div class="video-body"><h3>{v.title}</h3><p>{v.meta}</p></div></article>))}
      </div>
    </section>

    <section>
      <div class="section-title"><div><p>BLUEPRINT</p><h2>6-Month Growth Roadmap</h2></div></div>
      <div class="roadmap">
        {roadmap.map(m => (
          <article class="month"><div class="month-number">{m.n}</div><h3>{m.month}</h3><h4>{m.phase}</h4><ul>{m.tasks.map(t => <li>{t}</li>)}</ul><div class="target">🎯 {m.target}</div></article>
        ))}
      </div>
    </section>

    <section id="about">
      <div class="about-box">
        <div><p class="category">😎 KHURAFAATI SAMEER</p><h2>Building India's most relatable digital brand.</h2><p>I'm a digital content creator from India, passionate about viral, relatable content for Indian youth.</p><p>From trending topics and Bollywood gossip to side hustles and relationship advice — this blog is your one-stop hub.</p><div class="tags"><span class="tag">🔥 Trending News</span><span class="tag">💑 Relationships</span><span class="tag">🎬 Entertainment</span><span class="tag">💰 Money Tips</span></div></div>
        <div class="about-emoji">😎</div>
      </div>
    </section>

    <section id="contact">
      <div class="section-title"><div><p>LET'S CONNECT</p><h2>Get in Touch</h2></div></div>
      <div class="contact">
        <div class="contact-info"><h2>Contact</h2><p>Have a question, collaboration idea, or sponsorship opportunity?</p><div class="tags"><span class="tag">📧 Email</span><span class="tag">▶ YouTube</span><span class="tag">📱 Instagram</span></div></div>
        <form class="contact-form" id="contactForm" novalidate>
          <label class="sr-only" for="cName">Your Name</label><input id="cName" type="text" placeholder="Your Name" required />
          <label class="sr-only" for="cEmail">Email Address</label><input id="cEmail" type="email" placeholder="Email Address" required />
          <input type="text" placeholder="Subject" />
          <select aria-label="Inquiry type"><option>General Inquiry</option><option>Collaboration</option><option>Sponsorship</option><option>Business</option></select>
          <label class="sr-only" for="cMsg">Message</label><textarea id="cMsg" placeholder="Message" required></textarea>
          <button type="submit">Send Message 🚀</button>
        </form>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-grid">
      <div><h2>Khurafaati Sameer</h2><p>India's most viral entertainment and lifestyle blog.</p></div>
      <div><h3>Categories</h3><ul><li><a href="#categories">Trending & Viral</a></li><li><a href="#categories">Relationships</a></li><li><a href="#categories">Entertainment</a></li></ul></div>
      <div><h3>Quick Links</h3><ul><li><a href="#home">Home</a></li><li><a href="#articles">Latest Articles</a></li><li><a href="#videos">Videos</a></li></ul></div>
      <div><h3>Legal</h3><ul><li><a href="#">Privacy Policy</a></li><li><a href="#">Terms</a></li><li><a href="#">Disclaimer</a></li></ul></div>
    </div>
    <div class="copyright">© 2026 Khurafaati Sameer – All Rights Reserved. Made with ❤ in India.<br/>YouTube: @khurafaati_sameer | Instagram: @khurafaati_sameer</div>
  </footer>

<style>
  .topbar{background:#111;color:#fff;text-align:center;padding:8px 15px;font-size:12px;font-weight:700}
  header{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.98);backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
  .nav{max-width:1180px;margin:auto;min-height:58px;display:flex;align-items:center;gap:20px;padding:8px 20px}
  .logo{font-size:20px;font-weight:900;white-space:nowrap}.logo span{color:var(--accent)}
  .links{display:flex;gap:18px;margin-left:auto;font-size:13px;font-weight:700}.links a:hover{color:var(--accent)}
  .nav-actions{display:flex;align-items:center;gap:10px;margin-left:auto}
  .search{width:170px;border:1px solid #ddd;border-radius:30px;padding:8px 14px;background:#fafafa;outline:none}.search:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(255,61,0,.1)}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
  .hero{background:radial-gradient(circle at 80% 20%, rgba(255,61,0,.22), transparent 35%), linear-gradient(135deg, #111 0%, #21120d 100%);color:white;padding:84px 20px 76px}
  .hero-inner{max-width:1180px;margin:auto}.eyebrow{display:inline-block;background:var(--accent);padding:7px 13px;border-radius:30px;font-weight:800;font-size:12px;margin-bottom:16px}
  h1{max-width:700px;font-size:clamp(42px,6vw,68px);line-height:.95;letter-spacing:-2.5px;margin-bottom:18px}
  .hero p{max-width:620px;color:#d1d1d1;font-size:17px;margin-bottom:26px}
  .buttons{display:flex;gap:12px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;border-radius:10px;font-weight:800;border:1px solid #fff;cursor:pointer;transition:transform .2s, box-shadow .2s}.btn:hover{transform:translateY(-2px)}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.btn.secondary{background:transparent;color:white}.btn.small{padding:8px 14px;font-size:12px}
  section{max-width:1180px;margin:auto;padding:56px 20px}
  .section-title{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:20px}.section-title p{color:var(--muted);font-size:11px;font-weight:800;letter-spacing:.6px}.section-title h2{font-size:26px;letter-spacing:-.5px}
  .newsletter{max-width:820px;margin:-40px auto 0;position:relative;z-index:2;background:#fff;border:1px solid var(--border);box-shadow:0 18px 50px rgba(0,0,0,.12);border-radius:18px;padding:26px;text-align:center}
  .newsletter h2{font-size:20px;margin-bottom:4px}.newsletter p{color:var(--muted);font-size:13px;margin-bottom:14px}
  .newsletter-form{display:flex;max-width:520px;margin:auto;gap:8px}.newsletter-form input{flex:1;border:1px solid #ddd;padding:12px 14px;border-radius:10px}.newsletter-form button{border:0;border-radius:10px;background:var(--accent);color:white;padding:0 18px;font-weight:800;cursor:pointer}
  .toast{margin-top:12px;font-size:13px;font-weight:700;color:#0a7a2f;min-height:18px}
  .trend-strip{display:flex;gap:10px;overflow-x:auto;padding-bottom:8px;scrollbar-width:thin}.trend{flex:0 0 auto;padding:10px 14px;border-radius:10px;background:var(--accent-light);border:1px solid #ffe0d6;font-weight:700;font-size:13px}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .card{border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;background:white;transition:.25s}.card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(0,0,0,.08)}
  .card-top{min-height:120px;background:linear-gradient(135deg,#151515,#35170d);display:grid;place-items:center;font-size:44px}
  .card-body{padding:16px}.category{color:var(--accent);font-size:11px;font-weight:900;margin-bottom:6px}.badge-new{display:inline-block;background:var(--accent);color:white;font-size:9px;font-weight:900;padding:3px 6px;border-radius:4px;margin-bottom:6px}
  .card h3{font-size:15px;line-height:1.35;margin-bottom:10px}.meta{color:var(--muted);font-size:12px}
  .result-count{font-size:12px;color:var(--muted);font-weight:700}.no-results{text-align:center;padding:40px 20px;border:1px dashed var(--border);border-radius:var(--radius);margin-top:18px}
  .topic-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.topic{padding:18px;border:1px solid var(--border);border-radius:12px;display:grid;grid-template-columns:44px 1fr;gap:12px}.topic-icon{font-size:26px}.topic h3{font-size:13px}
  .about-box{background:#111;color:white;border-radius:18px;padding:36px;display:grid;grid-template-columns:1fr .8fr;gap:36px}.about-box p{color:#ccc;margin:12px 0;font-size:14px}.about-emoji{display:grid;place-items:center;font-size:110px}
  .tags{display:flex;flex-wrap:wrap;gap:8px}.tag{padding:7px 11px;border-radius:30px;background:#292929;font-size:12px;color:#ddd}
  .categories{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.category-box{border:1px solid var(--border);border-radius:12px;padding:20px;transition:.2s}.category-box:hover{border-color:var(--accent);transform:translateY(-3px)}.category-box .icon{font-size:28px}.category-box h3{margin:8px 0 2px;font-size:14px}.category-box p{color:var(--muted);font-size:12px}
  .stats{background:var(--accent);color:white;max-width:none;display:grid;grid-template-columns:repeat(4,1fr);text-align:center;padding:38px 20px}.stat strong{display:block;font-size:32px;line-height:1}.stat span{font-size:12px;opacity:.9}
  .video-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.video{background:#111;color:white;border-radius:12px;overflow:hidden}.video-thumb{height:120px;display:grid;place-items:center;font-size:36px;background:linear-gradient(135deg,#32160c,#151515);position:relative}.video-thumb span{position:absolute;font-size:14px;background:white;color:black;width:28px;height:28px;display:grid;place-items:center;border-radius:50%}.video-body{padding:14px}.video-body h3{font-size:13px;margin-bottom:6px}.video-body p{color:#aaa;font-size:11px}
  .roadmap{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.month{border:1px solid var(--border);border-radius:12px;padding:18px}.month-number{width:32px;height:32px;display:grid;place-items:center;background:var(--accent);color:white;border-radius:50%;font-weight:900;margin-bottom:12px;font-size:13px}.month h3{font-size:15px}.month h4{color:var(--accent);margin-bottom:10px;font-size:13px}.month ul{padding-left:18px;color:#666;font-size:13px}.target{margin-top:12px;background:var(--accent-light);border-radius:8px;padding:8px;color:#e63700;font-weight:800;font-size:12px}
  .contact{display:grid;grid-template-columns:.8fr 1.2fr;gap:36px}.contact-info h2{font-size:20px}.contact-info p{color:var(--muted);margin:12px 0;font-size:14px}
  .contact-form{display:grid;gap:10px}.contact-form input,.contact-form textarea,.contact-form select{width:100%;border:1px solid #ddd;border-radius:10px;padding:12px;outline:none}.contact-form textarea{min-height:120px;resize:vertical}.contact-form input:focus,.contact-form textarea:focus,.contact-form select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(255,61,0,.08)}.contact-form button{border:0;background:var(--accent);color:white;border-radius:10px;padding:12px;font-weight:900;cursor:pointer}
  footer{background:#111;color:white;padding:50px 20px 20px}.footer-grid{max-width:1180px;margin:auto;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px}footer p,footer li{color:#aaa;font-size:13px}footer ul{list-style:none;display:grid;gap:6px}footer a:hover{color:white}.copyright{max-width:1180px;margin:40px auto 0;padding-top:16px;border-top:1px solid #292929;text-align:center;color:#888;font-size:12px}
  .mobile-menu{display:none;background:none;border:0;font-size:24px;cursor:pointer}
  @media(max-width:900px){
    .links{display:none;position:absolute;top:58px;left:0;right:0;background:white;padding:20px;flex-direction:column;border-bottom:1px solid var(--border)}.links.open{display:flex}.mobile-menu{display:block}.search{display:none}.cards,.categories,.roadmap{grid-template-columns:repeat(2,1fr)}.video-grid{grid-template-columns:repeat(2,1fr)}.about-box{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr);gap:24px}.footer-grid{grid-template-columns:repeat(2,1fr)}
  }
  @media(max-width:600px){
    section{padding:42px 16px}.newsletter{margin:-28px 12px 0;padding:20px 16px}.newsletter-form{flex-direction:column}.cards,.categories,.roadmap,.topic-grid,.video-grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.footer-grid{grid-template-columns:1fr}.about-emoji{font-size:70px}
  }
</style>

<script>
  const menuBtn = document.getElementById('menuButton');
  const navLinks = document.getElementById('navLinks');
  const searchBox = document.getElementById('searchBox');
  const cards = document.querySelectorAll('.article-card');
  const noResults = document.getElementById('noResults');
  const noResultsTerm = document.getElementById('noResultsTerm');
  const resultCount = document.getElementById('resultCount');
  const clearBtn = document.getElementById('clearSearch');
  const toast = document.getElementById('toast');

  function toggleMenu(force){
    const isOpen = typeof force === 'boolean' ? force : !navLinks.classList.contains('open');
    navLinks.classList.toggle('open', isOpen);
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    menuBtn.textContent = isOpen ? '✕' : '☰';
  }
  menuBtn?.addEventListener('click', () => toggleMenu());
  document.addEventListener('click', (e) => {
    if(!navLinks.contains(e.target) && !menuBtn.contains(e.target)) toggleMenu(false);
  });
  document.addEventListener('keydown', (e) => { if(e.key==='Escape') toggleMenu(false); });
  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => toggleMenu(false)));

  function filterArticles(){
    const q = (searchBox.value || '').toLowerCase().trim();
    let visible = 0;
    cards.forEach(card => {
      const title = card.dataset.title || '';
      const show = !q || title.includes(q);
      card.style.display = show ? '' : 'none';
      if(show) visible++;
    });
    const hasQuery = q.length>0;
    noResults.hidden = !(hasQuery && visible===0);
    if(noResultsTerm) noResultsTerm.textContent = searchBox.value;
    if(resultCount) resultCount.textContent = hasQuery ? visible + ' results' : '';
  }
  searchBox?.addEventListener('input', filterArticles);
  clearBtn?.addEventListener('click', () => { searchBox.value=''; filterArticles(); searchBox.focus(); });

  function showToast(msg, isError=false){
    toast.textContent = msg;
    toast.style.color = isError ? '#b42318' : '#0a7a2f';
    setTimeout(()=>{ toast.textContent=''; }, 4000);
  }

  document.getElementById('newsletterForm')?.addEventListener('submit', (e)=>{
    e.preventDefault();
    const email = document.getElementById('emailInput').value.trim();
    if(!email || !email.includes('@')){ showToast('⚠️ Valid email daalo bhai', true); return; }
    showToast('🎉 Subscribed! Welcome to Khurafaati family');
    e.target.reset();
  });

  document.getElementById('contactForm')?.addEventListener('submit', (e)=>{
    e.preventDefault();
    showToast('🚀 Message received! Sameer jaldi reply karega');
    e.target.reset();
  });
</script>
</Layout>
