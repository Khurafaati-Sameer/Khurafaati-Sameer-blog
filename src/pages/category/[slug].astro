---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categorySlug, categoryMeta } from '../../data/taxonomy.js';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter(({ data }) => !data.draft);
  const slugs = [...new Set(articles.map(({ data }) => categorySlug(data.category)))];
  return slugs.map((slug) => ({
    params: { slug },
    props: { articles: articles.filter(({ data }) => categorySlug(data.category) === slug), slug },
  }));
}

const { articles, slug } = Astro.props;
const fallbackName = articles[0]?.data.category || slug;
const meta = categoryMeta[slug] || { name: fallbackName, description: `Articles in ${fallbackName}.` };
---

<Layout title={`${meta.name} | Khurafaati Sameer`} description={meta.description}>
  <main class="wrap">
    <header class="heading">
      <a class="back" href="/articles/">← All Articles</a>
      <p>CATEGORY</p>
      <h1>{meta.name}</h1>
      <span>{meta.description}</span>
    </header>
    <div class="grid">
      {articles.sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).map(({ id, data }) => (
        <article class="card">
          {data.featuredImage && <img src={data.featuredImage} alt={data.imageAlt || data.title} loading="lazy" />}
          <div class="body">
            <h2><a href={`/articles/${id}/`}>{data.title}</a></h2>
            <p>{data.description}</p>
            <div class="meta">{data.pubDate.toLocaleDateString('en-IN', { dateStyle: 'medium' })}{data.readingTime ? ` • ${data.readingTime} min read` : ''}</div>
          </div>
        </article>
      ))}
    </div>
  </main>
  <style>
    .wrap{max-width:1180px;margin:auto;padding:60px 20px 90px}.heading{margin-bottom:30px}.back{display:inline-block;margin-bottom:30px;color:var(--accent);font-size:12px;font-weight:900}.heading p{font-size:11px;font-weight:900;color:var(--accent);letter-spacing:.8px}.heading h1{color:var(--text);font-size:clamp(38px,5vw,58px);letter-spacing:-2px;margin:4px 0 8px}.heading span{display:block;max-width:700px;color:var(--muted);font-size:14px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{border:1px solid var(--border);border-radius:14px;overflow:hidden;background:#fff}.card img{width:100%;height:190px;object-fit:cover}.body{padding:18px}.card h2{font-size:18px;line-height:1.3;margin-bottom:9px}.card h2 a:hover{color:var(--accent)}.card p{color:var(--muted);font-size:13px;margin-bottom:12px}.meta{color:var(--muted);font-size:11px}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.grid{grid-template-columns:1fr}.wrap{padding:42px 16px 70px}}
  </style>
</Layout>
