---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thank You | Khurafaati Sameer" description="Your submission was received by Khurafaati Sameer.">
<main class="wrap"><div class="box"><div class="icon">✓</div><p class="eyebrow">SUBMISSION RECEIVED</p><h1>Thank you. ❤️</h1><p>Your message or subscription was submitted successfully. We'll get back to you when a response is needed.</p><div><a href="/" class="btn">Back to Home</a><a href="/articles/" class="btn secondary">Read Articles</a></div></div></main>
<style>
.wrap{min-height:65vh;display:grid;place-items:center;padding:60px 20px}.box{text-align:center;max-width:620px;border:1px solid var(--border);border-radius:18px;padding:45px 25px}.icon{width:55px;height:55px;display:grid;place-items:center;margin:0 auto 15px;border-radius:50%;background:var(--accent);color:white;font-size:28px;font-weight:900}.eyebrow{font-size:11px;font-weight:900;color:var(--accent)}.box h1{color:var(--text);font-size:48px;margin:5px auto 12px}.box p:not(.eyebrow){color:var(--muted);line-height:1.7;margin-bottom:24px}.btn{display:inline-block;background:var(--accent);color:#fff;padding:11px 18px;border-radius:9px;font-weight:800;margin:4px}.btn.secondary{background:#111}@media(max-width:600px){.box h1{font-size:38px}}
</style>
</Layout>
